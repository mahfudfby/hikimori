rules_version = '2';
// Tempel di Firebase Console → Firestore Database → Rules → Publish.
// Publik boleh MEMBACA konten; hanya akun admin yang login boleh MENULIS.
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin = custom claim `admin: true` ATAU email admin yang sudah terverifikasi (email_verified == true).
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.get('admin', false) == true
        || (request.auth.token.get('email_verified', false) == true
            && request.auth.token.get('email', '').lower() in
               ['admin@hikimori.app', 'mahfudfby@gmail.com', 'mahfudfebry@hikimori.web.id'])
      );
    }

    match /siteContent/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Riwayat versi konten (dibuat otomatis setiap "Publikasikan" di CMS) — hanya admin.
    match /siteContentHistory/{doc} {
      allow read, write: if isAdmin();
    }

    match /portfolio/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Data lama (versi sebelumnya) — tetap bisa dibaca, tidak dipakai lagi.
    match /siteData/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Selain koleksi di atas: tertutup untuk semua
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
