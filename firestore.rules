rules_version = '2';
// Tempel di Firebase Console → Firestore Database → Rules → Publish.
// Publik boleh MEMBACA konten; hanya akun admin yang login boleh MENULIS.
service cloud.firestore {
  match /databases/{database}/documents {
    // admin@hikimori.app & mahfudfby@gmail.com: akun login CMS yang sudah terdaftar di Firebase Auth.
    // Email lain wajib terverifikasi, agar tidak bisa didaftarkan orang lain lebih dulu lewat Firebase Auth.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email in ['admin@hikimori.app', 'mahfudfby@gmail.com']
        || (request.auth.token.email == 'mahfudfebry@hikimori.web.id'
            && request.auth.token.email_verified == true)
      );
    }

    match /siteContent/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Riwayat versi konten (dibuat otomatis setiap "Publikasikan" di CMS) — hanya admin.
    match /siteContentHistory/{doc} {
      allow read, write: if isAdmin();
    }

    match /portfolio/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Data lama (versi sebelumnya) — tetap bisa dibaca, tidak dipakai lagi.
    match /siteData/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Selain koleksi di atas: tertutup untuk semua
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
