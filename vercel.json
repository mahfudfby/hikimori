{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "routes": [
    { "src": "/static/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "/sw.js", "headers": { "Cache-Control": "no-cache" }, "continue": true },
    { "src": "/admin(.*)", "headers": { "X-Robots-Tag": "noindex" }, "continue": true },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "SAMEORIGIN",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      },
      "continue": true
    },
    { "src": "/about/?", "status": 308, "headers": { "Location": "/profil" } },
    { "src": "/services/?", "status": 308, "headers": { "Location": "/layanan" } },
    { "src": "/portfolio/?", "status": 308, "headers": { "Location": "/portofolio" } },
    { "handle": "filesystem" },
    { "src": "/(profil|pengalaman|pendidikan|sertifikat|keahlian|layanan|portofolio|kontak)/?", "dest": "/$1/index.html" },
    { "src": "/admin(/.*)?", "dest": "/index.html" },
    { "src": "/.*", "status": 404, "dest": "/404.html" }
  ]
}
