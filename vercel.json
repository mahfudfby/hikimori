{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "routes": [
    { "src": "/static/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "/sw.js", "headers": { "Cache-Control": "no-cache" }, "continue": true },
    { "src": "/admin(.*)", "headers": { "X-Robots-Tag": "noindex" }, "continue": true },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "SAMEORIGIN",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://*.googleapis.com https://*.firebaseapp.com https://api.cloudinary.com https://res.cloudinary.com https://www.tiktok.com; frame-src https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
      },
      "continue": true
    },
    { "src": "/about/?", "status": 308, "headers": { "Location": "/profil" } },
    { "src": "/services/?", "status": 308, "headers": { "Location": "/layanan" } },
    { "src": "/portfolio/?", "status": 308, "headers": { "Location": "/portofolio" } },
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(profil|pengalaman|pendidikan|sertifikat|keahlian|layanan|portofolio|kontak)/?", "dest": "/$1/index.html" },
    { "src": "/portofolio/([A-Za-z0-9_-]+)/?", "dest": "/portofolio/$1/index.html", "check": true },
    { "src": "/portofolio/[^/]+(/index[.]html)?/?", "dest": "/portofolio/index.html" },
    { "src": "/admin(/.*)?", "dest": "/index.html" },
    { "src": "/cv/?", "dest": "/index.html" },
    { "src": "/.*", "status": 404, "dest": "/404.html" }
  ]
}
